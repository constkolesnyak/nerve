# Config (user-specific)
config.yaml
config.local.yaml

# Environment
.env
.env.local
!.env.example

# Data
data/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Web UI build
web/node_modules/
web/dist/

# Runtime
*.db
*.db-journal
*.log
nerve.pid

# Certs
*.pem
*.key

# Sync data
sync_data/
*.jsonl
# ...except checked-in test fixtures, which the suite needs on a clean checkout
!tests/fixtures/**/*.jsonl

# Docker (generated by 'nerve init' — safe to commit if sharing)
Dockerfile
docker-compose.yml
docker-entrypoint.sh
.dockerignore
# Local too: COPY'd by the Dockerfile above, and specific to this machine's
# vox-harbor mount — nothing upstream can use it.
voxenv

# OS
.DS_Store
Thumbs.db

# Local planning docs — not for PRs
docs/plans/

# Junk a test writes when a MagicMock config reaches a Path(...).mkdir call
# (dir name is the mock repr, e.g. MagicMock/mock.codex.home_dir/<id>).
# Culprit not yet identified — only reproduces in a full-suite run, which
# reboots the Pi, so this keeps it out of commits meanwhile.
MagicMock/
